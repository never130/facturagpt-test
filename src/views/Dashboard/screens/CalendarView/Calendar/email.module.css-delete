.box {
	width: 100%;
	display: inline-flex;
	align-items: center;
	height: 100%;
	overflow-y: scroll;
	padding: 20px;
}
.email {
	max-width: 600px;
	margin: 20px auto;
	display: inline-flex;
	flex-direction: column;
	gap: 8px;
}

.header {
	border: 1px solid var(--border-color);
	display: flex;
	align-items: center;
	gap: 4px;
	border-radius: 6px;
	.iconBox {
		border-right: 1px solid var(--border-color);
		min-width: 100px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		background: var(--white-color);
		height: 180px;
		.icon {
			display: inline-flex;
			flex-direction: column;
			gap: 2px;
			font-size: 20px;
			font-weight: 500;
			text-align: center;
			border-radius: 6px;
			overflow: hidden;
			box-shadow: 0px 0px 10px -4px var(--_10a37f-background);
			min-width: 70px;
			width: 70px;
			.month {
				background: var(--_10a37f-background);
				color: var(--_16c0982e-background);
				font-size: 12px;
				padding: 2px;
			}
			.day {
				color: var(--_10a37f-background);
				font-size: 28px;
				font-weight: 600;
			}
			.label {
				border-top: 1px solid var(--border-color);
			}
		}
	}
	.content {
		display: inline-flex;
		flex-direction: column;
		justify-content: flex-start;
		align-items: flex-start;
		gap: 8px;
		min-width: 350px;
		width: 350px;
		border-right: 1px solid var(--border-color);
		.top {
			display: inline-flex;
			flex-direction: column;
			gap: 2px;
			b {
				font-size: 15px;
				font-weight: 600;
			}
			.buttonView {
				text-align: left;
				line-height: 10px;
				color: var(--_10a37f-background);
				font-weight: 600;
				font-size: 13px;
				text-decoration: underline;
			}
		}
		ul {
			font-size: 12px;
			li {
				display: inline-flex;
				align-items: center;
				gap: 4px;
				span {
					width: 45px;
					color: var(--text-color-secondary);
				}
				p {
					font-size: 14px;
				}
			}
		}
		.buttons {
			display: flex;
			align-items: center;
			gap: 6px;
			button {
				padding: 4px 10px;
				border-radius: 4px;
				&.yes {
					display: inline-flex;
					align-content: center;
					background: var(--_10a37f-background);
					color: var(--_16c0982e-background);
					padding-right: 0px;
					gap: 6px;
					> div {
						border-left: 1px solid var(--_16c098-background);
						svg {
							color: var(--_16c0982e-background);
						}
					}
				}
				&.maybe {
					border: 1px solid var(--border-color);
				}
				&.no {
					border: 1px solid var(--border-color);
				}
				&.more {
					color: var(--_3c3a3a-color);
				}
			}
		}
	}
	.events {
		display: inline-flex;
		flex-direction: column;
		gap: 2px;
		b {
			font-size: 16px;
		}
		span {
			font-size: 10px;
		}
		ul {
			display: inline-flex;
			flex-direction: column;
			li {
				font-size: 12px;
				display: inline-flex;
				flex-direction: column;
				gap: 2px;
				a {
					font-size: 10px;
					color: var(--text-color-secondary);
					text-decoration: underline;
				}
			}
		}
	}
}

.container {
	display: flex;
	align-items: flex-start;
	gap: 30px;
	border: 1px solid var(--border-color);
	font-size: 12px;
	padding: 16px;
	border-radius: 5px;
	color: 30px;
	.left {
		max-width: calc(100% - 200px);
		display: inline-flex;
		flex-direction: column;
		gap: 4px;
		> div {
			display: inline-flex;
			flex-direction: column;
			gap: 4px;
		}
		a {
			color: var(--_10a37f-background);
			margin: 0 3px;
			text-decoration: underline;
		}
	}
	.right {
		max-width: 200px;
		display: inline-flex;
		flex-direction: column;
		gap: 20px;
		> div {
			display: inline-flex;
			flex-direction: column;
			gap: 2px;
			b {
				font-size: 12px;
			}
		}
		a {
			color: var(--_10a37f-background);
			margin: 0 3px;
			text-decoration: underline;
		}
		.buttonJoin {
			width: 100%;
			padding: 10px;
			border-radius: 4px;
			background: var(--_10a37f-background);
			color: var(--_16c0982e-background);
			cursor: pointer;
			border: none;
			outline: none;
			&:hover {
				background: var(--_16c098-background);
			}
		}
	}
}

.footer {
	font-size: 10px;
	a {
		color: var(--_10a37f-background);
		margin: 0px 3px;
	}
}
