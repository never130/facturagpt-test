import styles from './Kanban.module.css'
import { useTranslation } from 'react-i18next'
import { useDispatch } from 'react-redux'
import { useNavigate, useParams } from 'react-router-dom'
import { v4 as uuidv4 } from 'uuid'

import { calculateTimeAgo, calculateTimeUntil } from '../../../utils'

import ModalToDoList from './ModalToDoList'
import ModalTicket from './ModalTicket'
import NoneKanban from './NoneKanban'
import Progress from './Progress'
import ModalLink from '../../shared/ModalLink'

import {
	initialTicket,
	initialTask,
	setKanban
} from '../../../slices/kanbanSlice'
import { setModal } from '../../../slices/iamSlice'
import {
	fetchKanban,
	fetchsKanban,
	addKanban,
	deleteKanban,
	updateKanban,
} from '../../../actions/kanban'

import { useSelector } from 'react-redux'
import { useEffect, useRef, useState } from 'react'

const Kanban = ({ isShowGPT }) => {
	const { t } = useTranslation()
	const { lng, version } = useParams()

	const navigate = useNavigate()
	const dispatch = useDispatch()

	const { user } = useSelector((state) => state.iam)

	const { kanban, kanbans } = useSelector((state) => state.kanban)

	useEffect(() => {
		dispatch(
			fetchsKanban({
				workspaceId: user?.id,
			})
		)
	}, [])

	const handleModalLink = () => {
		dispatch(setModal(<ModalLink />))
	}

	const handleSelectKanban = (kanban) => {
		if (kanban._id) {
			dispatch(
				fetchKanban({
					workspaceId: user.id,
					kanbanId: kanban._id,
				})
			)
		}
	}

	const handleDeleteKanban = (kanban) => {
		dispatch(
			deleteKanban({
				workspaceId: user?.id,
				data: kanban,
			})
		)
	}

	

	const [waitSaveKanban, setWaitSaveKanban] = useState(false)

	const handleSaveKanban = async () => {
		setWaitSaveKanban(true)

		await dispatch(
			updateKanban({
				workspaceId: user?.id,
				kanban: kanban,
			})
		)
		setWaitSaveKanban(false)
	}

	const [isShowResume, setIsShowResume] = useState(null)
	const [resume, setResume] = useState({
		pendent: 0,
		deny: 0,
		sucess: 0,
	})

	useEffect(() => {
		if (kanban && kanban.tickets) {
			let pendent = 0
			let deny = 0
			let success = 0
			kanban.tickets.map((ticket, index) => {
				ticket.tasks.map((task, index) => {
					if (task) {
						if (
							task.status == 200 ||
							task.status == 201 ||
							task.status == 202
						) {
							pendent++
						} else if (task.status == 203) {
							deny++
						} else if (task.status == 204) {
							success++
						}
					}
				})
			})

			const total = pendent + deny + success

			setResume({
				pendent: parseInt((pendent / total) * 100),
				deny: parseInt((deny / total) * 100),
				success: parseInt((success / total) * 100),
			})

			if (total > 0) {
				setIsShowResume(true)
			} else {
				setIsShowResume(false)
			}
		}
	}, [kanban])

	const inputNewKanban = useRef(null)

	const [stateNewKanban, setStateNewKanban] = useState({
		title: '',
		tickets: [],
		collaborators: [],
	})
	const [isShowNewKanban, setIsShowKanban] = useState(false)

	const handleShowNewKanban = () => {
		setIsShowKanban(true)
		setTimeout(() => {
			inputNewKanban.current.focus()
		}, 0)
	}

	const handleChangeNewKanban = (e) => {
		const { name, value } = e.target

		if (e.key === 'Enter') {
			handleNewKanban()
			return false
		}

		setStateNewKanban((prevState) => ({
			...prevState,
			[name]: value,
		}))
	}

	const handleNewKanban = () => {
		dispatch(
			addKanban({
				workspaceId: user?.id,
				kanbanId: '1234',
				data: stateNewKanban,
			})
		)

		setStateNewKanban((prev) => ({ ...prev, title: '' }))
		setIsShowKanban(false)
	}

	const handleBlurNewKanban = () => {
		setStateNewKanban((prev) => ({ ...prev, title: '' }))
		setIsShowKanban(false)
	}

	const handleAddNewTicket = () => {
		const updatedKanban = {
			...kanban,
			tickets: [
				...kanban.tickets,
				{
					...initialTicket,
					id: uuidv4(),
				},
			],
		}

		dispatch(setKanban(updatedKanban))
	}

	const handleDuplyTicket = (ticketId) => {
		const ticketToDuplicate = kanban.tickets.find(
			(ticket) => ticket.id === ticketId
		)

		if (!ticketToDuplicate) {
			console.error(`Ticket with ID ${ticketId} not found.`)
			return
		}

		const duplicatedTicket = {
			...ticketToDuplicate,
			id: uuidv4(),
		}

		const duplicatedTasks = ticketToDuplicate.tasks.map((task) => ({
			...task,
			id: uuidv4(),
		}))

		duplicatedTicket.tasks = duplicatedTasks

		const originalTicketIndex = kanban.tickets.findIndex(
			(ticket) => ticket.id === ticketId
		)

		const insertIndex = originalTicketIndex + 1

		const updatedTickets = [...kanban.tickets]
		updatedTickets.splice(insertIndex, 0, duplicatedTicket)

		const updatedKanban = {
			...kanban,
			tickets: updatedTickets,
		}

		dispatch(setKanban(updatedKanban))
	}

	const handleDeleteTicket = (ticketId) => {
		const filteredTickets = kanban.tickets.filter(
			(ticket) => ticket.id !== ticketId
		)

		if (filteredTickets.length === kanban.tickets.length) {
			console.error(`Ticket with ID ${ticketId} not found.`)
			return
		}

		const updatedKanban = {
			...kanban,
			tickets: filteredTickets,
		}

		dispatch(setKanban(updatedKanban))
	}

	const handleAddNewTask = (index) => {
		const updatedTickets = [...kanban.tickets]
		updatedTickets[index] = {
			...updatedTickets[index],
			tasks: [
				...updatedTickets[index].tasks,
				{
					...initialTask,
					id: uuidv4(),
				},
			],
		}
		const updatedKanban = {
			...kanban,
			tickets: updatedTickets,
		}

		dispatch(setKanban(updatedKanban))
	}

	const handleToDoList = ({ ticket, task }) => {
		dispatch(
			setModal({
				component: <ModalToDoList ticket={ticket} task={task} />,
				option: { close: false },
			})
		)
	}

	const handleEditTask = ({ ticket, task }) => {
		dispatch(
			setModal({
				component: (
					<ModalTicket
						dataPriority={dataPriority}
						dataStatus={dataStatus}
						ticket={ticket}
						task={task}
					/>
				),
				option: { close: false },
			})
		)
	}

	const handleDeleteTask = ({ ticket, task }) => {
		const ticketIndex = kanban.tickets.findIndex((t) => t.id == ticket.id)
		const updatedTickets = [...kanban.tickets]
		const tasks = updatedTickets[ticketIndex].tasks

		const updatedTasks = tasks.filter((t) => t.id !== task.id)

		updatedTickets[ticketIndex] = {
			...updatedTickets[ticketIndex],
			tasks: updatedTasks,
		}

		const updatedKanban = {
			...kanban,
			tickets: updatedTickets,
		}

		dispatch(setKanban(updatedKanban))
	}

	const handleChangeTitle = (e, indexTicket) => {
		const { value } = e.target
		let updatedTickets = [...kanban.tickets]

		updatedTickets[indexTicket] = {
			...updatedTickets[indexTicket],
			title: value,
		}

		const updatedKanban = {
			...kanban,
			tickets: updatedTickets,
		}

		dispatch(setKanban(updatedKanban))
	}

	const handleInputTask = (e, indexTicket, indexTask) => {
		const { name, value } = e.target

		const updatedTickets = [...kanban.tickets]
		const updatedTasks = [...updatedTickets[indexTicket].tasks]

		updatedTasks[indexTask] = {
			...updatedTasks[indexTask],
			[name]: value,
		}

		updatedTickets[indexTicket] = {
			...updatedTickets[indexTicket],
			tasks: updatedTasks,
		}

		const updatedKanban = {
			...kanban,
			tickets: updatedTickets,
		}

		dispatch(setKanban(updatedKanban))
	}

	const [isShowColor, setIsShowColor] = useState(false)
	const handleMouseEnter = () => {}

	const [draggedTask, setDraggedTask] = useState(null)

	const [draggedItem, setDraggedItem] = useState(null)

	const handleDragStart = (e, ticket) => {
		setDraggedItem(ticket)
	}

	const handleDragOver = (e) => {
		e.preventDefault()
	}

	const handleDragStartTask = (e, task, ticket) => {
		setDraggedTask(task)
		setDraggedItem(ticket)
	}

	const handleDrop = (e, targetTicket) => {
		setDraggedTask(null)

		if (draggedTask) {
			const updatedTickets = [...kanban.tickets]

			const targetTicketIndex = updatedTickets.findIndex(
				(ticket) => ticket.id === targetTicket.id
			)
			if (targetTicketIndex === -1) return

			if (draggedItem.id === targetTicket.id) {
				return
			}

			const updatedTargetTasks = [
				...updatedTickets[targetTicketIndex].tasks,
				draggedTask,
			]

			updatedTickets[targetTicketIndex] = {
				...updatedTickets[targetTicketIndex],
				tasks: updatedTargetTasks,
			}

			const draggedTicketIndex = updatedTickets.findIndex(
				(ticket) => ticket.id === draggedItem.id
			)
			const updatedDraggedTasks = updatedTickets[
				draggedTicketIndex
			].tasks.filter((task) => task.id !== draggedTask.id)

			updatedTickets[draggedTicketIndex] = {
				...updatedTickets[draggedTicketIndex],
				tasks: updatedDraggedTasks,
			}

			dispatch(
				setKanban({
					...kanban,
					tickets: updatedTickets,
				})
			)
		} else if (draggedItem) {
			const updatedTickets = [...kanban.tickets]
			const draggedIndex = updatedTickets.findIndex(
				(ticket) => ticket.id === draggedItem.id
			)
			const targetIndex = updatedTickets.findIndex(
				(ticket) => ticket.id === targetTicket.id
			)

			if (draggedIndex !== -1 && targetIndex !== -1) {
				const draggedTicket = updatedTickets[draggedIndex]
				updatedTickets.splice(draggedIndex, 1)
				updatedTickets.splice(targetIndex, 0, draggedTicket)

				dispatch(
					setKanban({
						...kanban,
						tickets: updatedTickets,
					})
				)
			}
		}

		setDraggedItem(null)
	}

	const handleDropTask = (e, targetTicket, targetTask) => {
		e.preventDefault()

		if (!draggedTask || !draggedItem) return

		const updatedTickets = kanban.tickets.map((ticket) => ({
			...ticket,
			tasks: [...ticket.tasks],
		}))

		const targetTicketIndex = updatedTickets.findIndex(
			(ticket) => ticket.id === targetTicket.id
		)
		const draggedTicketIndex = updatedTickets.findIndex(
			(ticket) => ticket.id === draggedItem.id
		)

		if (draggedTicketIndex === -1 || targetTicketIndex === -1) return

		const draggedIndex = updatedTickets[draggedTicketIndex].tasks.findIndex(
			(task) => task.id === draggedTask.id
		)
		const targetIndex = updatedTickets[targetTicketIndex].tasks.findIndex(
			(task) => task.id === targetTask.id
		)

		const movedTask = updatedTickets[draggedTicketIndex].tasks[draggedIndex]

		updatedTickets[draggedTicketIndex].tasks.splice(draggedIndex, 1)

		const adjustedTargetIndex =
			draggedIndex < targetIndex ? targetIndex + 1 : targetIndex

		updatedTickets[targetTicketIndex].tasks.splice(
			adjustedTargetIndex,
			0,
			movedTask
		)

		dispatch(
			setKanban({
				...kanban,
				tickets: updatedTickets,
			})
		)
	}

	const [selectedPriority, setSelectedPriority] = useState({})
	const [selectedStatus, setSelectedStatus] = useState({})

	const dataPriority = [
		{
			text: 'Crítico',
			value: 100,
		},
		{
			text: 'Alto',
			value: 101,
		},
		{
			text: 'Medio',
			value: 102,
		},
		{
			text: 'Bajo',
			value: 103,
		},
	]

	const dataStatus = [
		{
			text: 'Pendiente',
			value: 200,
		},
		{
			text: 'En proceso',
			value: 201,
		},
		{
			text: 'En pausa',
			value: 202,
		},
		{
			text: 'Revisar',
			value: 203,
		},
		{
			text: 'Terminado',
			value: 204,
		},
	]

	useEffect(() => {
		if (selectedPriority.value && selectedPriority.indexTicket > -1) {
			const value = selectedPriority.value

			const updatedTickets = [...kanban.tickets]
			const updatedTasks = [
				...updatedTickets[selectedPriority.indexTicket].tasks,
			]

			updatedTasks[selectedPriority.indexTask] = {
				...updatedTasks[selectedPriority.indexTask],
				priority: value,
			}

			updatedTickets[selectedPriority.indexTicket] = {
				...updatedTickets[selectedPriority.indexTicket],
				tasks: updatedTasks,
			}

			const updatedKanban = {
				...kanban,
				tickets: updatedTickets,
			}

			dispatch(setKanban(updatedKanban))
		}
	}, [selectedPriority])

	useEffect(() => {
		if (selectedStatus.value && selectedStatus.indexTicket > -1) {
			const value = selectedStatus.value

			const updatedTickets = [...kanban.tickets]
			const updatedTasks = [...updatedTickets[selectedStatus.indexTicket].tasks]

			updatedTasks[selectedStatus.indexTask] = {
				...updatedTasks[selectedStatus.indexTask],
				status: value,
			}

			updatedTickets[selectedStatus.indexTicket] = {
				...updatedTickets[selectedStatus.indexTicket],
				tasks: updatedTasks,
			}

			const updatedKanban = {
				...kanban,
				tickets: updatedTickets,
			}

			dispatch(setKanban(updatedKanban))
		}
	}, [selectedStatus])

	const textAreaRefs = useRef([])

	const adjustHeight = (index) => {
		const textArea = textAreaRefs.current[index]
		if (textArea) {
			textArea.style.height = 'auto'
			textArea.style.height = textArea.scrollHeight + 'px'
		}
	}

	const restoreHeight = (index) => {
		const textArea = textAreaRefs.current[index]
		if (textArea) {
			textArea.style.height = '56px'
		}
	}

	const handleCalendar = () => {
		navigate(`/${lng}/${version}/app/calendar`)
	}

	return (
		<div className={styles.containerKanban}>
			{true && (
				<div className={styles.header}>
					<ul className={styles.listKanbans}>
						<li
							className={styles.buttonAddKanban}
							style={{ display: !isShowNewKanban ? 'none' : '' }}
						>
							<input
								type='text'
								name='title'
								ref={inputNewKanban}
								spellCheck={false}
								placeholder={t('kanban.t5')}
								value={stateNewKanban.title}
								onChange={(e) => handleChangeNewKanban(e)}
								onKeyDown={(e) => handleChangeNewKanban(e)}
								onBlur={() => handleBlurNewKanban()}
							/>
						</li>
						{kanbans.map((_kanban, index) => (
							<li
								key={index}
								className={`${kanban?._id == _kanban?._id ? styles.active : ''}`}
								onClick={() => handleSelectKanban(_kanban)}
							>
								{_kanban?.title || 'Not title'}
								<button
									onClick={(e) => {
										e.stopPropagation()
										handleDeleteKanban(_kanban)
									}}
								>
									{/* prettier-ignore */}
									<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24"> <path stroke="currentColor" strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M6 18 17.94 6M18 18 6.06 6" /> </svg>
								</button>
							</li>
						))}
					</ul>
				
					<div className={styles.buttons}>
		
						<button onClick={() => handleShowNewKanban()}>
							{t('kanban.t2')}
						</button>
						{kanban && (
							<button onClick={() => handleSaveKanban()}>
								{waitSaveKanban ? (
									<span>{t('kanban.t4')}</span>
								) : (
									<span>{t('kanban.t3')}</span>
								)}
							</button>
						)}
					</div>
				</div>
			)}

			{kanban ? (
				<ul
					className={`${styles.listTickets} ${!isShowResume ? styles.height : ''} ${isShowGPT ? styles.showGPT : ''}`}
				>
					{kanban.tickets.map((ticket, indexTicket) => (
						<li
							key={indexTicket}
							draggable
							onDragStart={(e) => handleDragStart(e, ticket)}
							onDragOver={(e) => handleDragOver(e)}
							onDrop={(e) => handleDrop(e, ticket)}
						>
							<div className={styles.headerTicket}>
								<input
									type=''
									placeholder={'Escribe el titulo'}
									spellCheck={false}
									value={ticket?.title}
									onChange={(e) => handleChangeTitle(e, indexTicket)}
								/>
							</div>
							<div className={styles.buttonTicket}>
								<button onClick={() => handleDuplyTicket(ticket.id)}>
									Duplicar
								</button>
								<button onClick={() => handleDeleteTicket(ticket.id)}>
									Eliminar
								</button>
							</div>
							{ticket.tasks.map((task, indexTask) => {
								return (
									<div
										key={indexTask}
										className={styles.ticket}
										draggable
										onDragStart={(e) => handleDragStartTask(e, task, ticket)}
										onDragOver={(e) => handleDragOver(e)}
										onDrop={(e) => handleDropTask(e, ticket, task)}
									>
										<div
											className={styles.color}
											onMouseEnter={() => handleMouseEnter()}
										>
											{task.color}
											<ul className={styles.modalColor}>
												<li />
												<li />
												<li />
												<li />
												<li />
											</ul>
										</div>
										<div className={styles.content}>
											<div className={styles.top}>
												<b className={styles.title}>{task?.title}</b>
												<div className={styles.time}>
													<div className={styles.updatedAt}>
														{calculateTimeAgo(task.updatedAt)}
													</div>
												</div>
											</div>
											<div className={styles.topHover}>
												<button
													onClick={() => handleToDoList({ ticket, task })}
												>
													ToDoList
												</button>
												<button
													onClick={() => handleEditTask({ ticket, task })}
												>
													Editar
												</button>
												<button
													className={styles.delete}
													onClick={() => handleDeleteTask({ ticket, task })}
												>
													Eliminar
												</button>
											</div>

											<div className={styles.description}>
												<textarea
													ref={(el) => (textAreaRefs.current[task.id] = el)}
													type='text'
													name='description'
													placeholder={'Insertar descripción'}
													value={task?.description}
													spellCheck={false}
													onBlur={() => restoreHeight(task.id)}
													onFocus={() => adjustHeight(task.id)}
													onChange={(e) => {
														handleInputTask(e, indexTicket, indexTask)
														adjustHeight(task.id)
													}}
												/>
											</div>
											<div className={styles.progress}>
												<div className={`${styles.status} ${styles.select}`}>
													<SearchList
														selected={{ value: task?.priority }}
														setSelected={setSelectedPriority}
														placeholder='Prioridad'
														name='priority'
														data={dataPriority}
														styles={styles}
														indexTicket={indexTicket}
														indexTask={indexTask}
													/>
												</div>
												<div className={`${styles.priority} ${styles.select}`}>
													<SearchList
														selected={{ value: task?.status }}
														setSelected={setSelectedStatus}
														placeholder='Estado'
														name='status'
														data={dataStatus}
														styles={styles}
														indexTicket={indexTicket}
														indexTask={indexTask}
													/>
												</div>
											</div>
											<div className={styles.bottom}>
												<div className={styles.taskDo}>
													{task.list?.length > 0 ? (
														<div>
															{/* prettier-ignore */}
															<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24"> <path stroke="currentColor" strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M15 4h3a1 1 0 0 1 1 1v15a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1h3m0 3h6m-3 5h3m-6 0h.01M12 16h3m-6 0h.01M10 3v4h4V3h-4Z" /> </svg>
															{`${task.list.filter((l) => l.status === 101).length}/ ${task.list.length}`}
														</div>
													) : (
														<div>
															{/* prettier-ignore */}
															<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24"> <path stroke="currentColor" strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M15 4h3a1 1 0 0 1 1 1v15a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1h3m0 3h6m-5-4v4h4V3h-4Z" /> </svg>
														</div>
													)}
												</div>
												{task.date && (
													<div
														className={styles.timeAgo}
														onClick={() => handleEditTask({ ticket, task })}
													>
														{calculateTimeUntil(task.date) ? (
															<span>{calculateTimeUntil(task.date)}</span>
														) : (
															<span>Ya ha pasado la fecha</span>
														)}
													</div>
												)}

												<div className={styles.by}>
													<div>{task.createdBy}</div>
													<div>{task.updatedBy}</div>
												</div>
												<div className={styles.collaborator}>
													{JSON.stringify(task.collaborator)}
													<div>{'A'}</div>
												</div>
											</div>
										</div>
									</div>
								)
							})}
							<button
								className={styles.buttonAddTask}
								onClick={() => handleAddNewTask(indexTicket)}
							>
								Crear uno nuevo
							</button>
						</li>
					))}
					<li className={styles.liContainer} style={{ width: 200 }}>
						<div
							className={styles.buttonAddTicket}
							onClick={() => handleAddNewTicket()}
						>
							<span>Crear un ticket</span>
							<div>
								<p>Añade un color y una fecha para añdir este ticket.</p>
								<div>
									Nuevo ticket
									<button>Nuevo</button>
								</div>
							</div>
						</div>
					</li>
				</ul>
			) : (
				<NoneKanban />
			)}
			{isShowResume && (
				<div>
					<Progress resume={resume} />
				</div>
			)}
		</div>
	)
}

export default Kanban

export const SearchList = ({
	selected,
	setSelected,
	placeholder,
	data,
	styles,
	indexTicket,
	indexTask,
}) => {
	const dispatch = useDispatch()

	const [isShow, setIsShow] = useState(false)

	const [filter, setFilter] = useState('')
	const [selectedItem, setSelectedItem] = useState(null)
	const [results, setResults] = useState([])

	useEffect(() => {
		const filteredResults = data
			.map((item) => {
				if (typeof item === 'string') {
					return { title: item }
				} else {
					return item
				}
			})
			.filter((item) => {
				return item.text.toLowerCase().includes(filter.toLowerCase())
			})

		setResults(filteredResults)
	}, [filter, data])

	useEffect(() => {
		if (selected.value) {
			const item = data.filter((d) => d.value == selected.value)

			if (item.length > 0) {
				setSelectedItem(item[0])
			}
		}
	}, [selected])

	const handleSelect = (item) => {
		setSelectedItem(item)
		setFilter('')
		setResults([])
		setSelected({
			...item,
			indexTicket,
			indexTask,
		})
	}

	const handleInputChange = (e) => {
		setSelectedItem(null)
		setFilter(e.target.value)
	}

	return (
		<div className={styles.boxSearch}>
			<div className={`${styles.dot} ${styles['_' + selectedItem?.value]}`} />
			<input
				type='text'
				spellCheck={false}
				placeholder={placeholder}
				value={selectedItem !== null ? selectedItem.text : filter}
				onChange={handleInputChange}
				onFocus={() => setIsShow(true)}
				onBlur={() => setTimeout(() => setIsShow(false), 100)}
			/>
			{isShow && results.length > 0 && (
				<ul>
					{results.map((result, index) => (
						<li key={index} onClick={() => handleSelect(result)}>
							<div className={`${styles.dot} ${styles['_' + result.value]}`} />
							{result.text}
						</li>
					))}
				</ul>
			)}
			{results.lengtbh == 0 && (
				<div className={styles.notFound}>
					{/* prettier-ignore */}
					<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24"> <path stroke="currentColor" strokeLinecap="round" strokeWidth="2" d="M18.796 4H5.204a1 1 0 0 0-.753 1.659l5.302 6.058a1 1 0 0 1 .247.659v4.874a.5.5 0 0 0 .2.4l3 2.25a.5.5 0 0 0 .8-.4v-7.124a1 1 0 0 1 .247-.659l5.302-6.059c.566-.646.106-1.658-.753-1.658Z" /> </svg>
					<p>No hay resultados</p>
				</div>
			)}
		</div>
	)
}
