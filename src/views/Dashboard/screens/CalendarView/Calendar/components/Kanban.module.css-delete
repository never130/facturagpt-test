.header {
	width: 100%;
	display: inline-flex;
	justify-content: space-between;
	align-items: center;
	padding: 6px 10px 6px;
	gap: 20px;
	.listProjects {
		display: inline-flex;
		align-items: center;
		gap: 12px;
		overflow-x: scroll;
		margin-right: 20px;
		width: 100%;
		&::-webkit-scrollbar {
			display: none;
		}
		li {
			display: inline-flex;
			align-items: center;
			gap: 8px;
			padding: 2px 6px 2px 10px;
			border-radius: 4px;
			cursor: pointer;
			text-wrap: nowrap;
			font-size: 20px;
			font-weight: 500;
			line-height: 35px;
			&:hover {
				background: var(--color-primary-5);
			}

			button {
				width: 13px;
				height: 13px;
				border-radius: 4px;
				display: inline-flex;
				align-items: center;
				justify-content: center;
				color: var(--color-primary-0);
				background-color: transparent;
				cursor: pointer;
				svg {
					max-width: 14px;
					height: 14px;
				}
				&:hover {
					background: var(--color-primary-0);
					color: var(--color-primary-7);
				}
			}
			&.active {
				background: var(--color-primary-0) !important;
				color: var(--color-primary-6);
				button {
					color: var(--color-primary-6);
					border: none;

					&:hover {
						background: var(--color-primary-7);
						color: var(--color-primary-0);
					}
				}
			}
		}

		.buttonAddProject {
			background: var(--color-primary-0);
			color: var(--color-primary-6);
			padding: 0px;
			button {
				padding: 2px 20px;
			}
			input {
				background: var(--color-primary-7);
				color: var(--color-primary-2);
				outline: none;
				border: none;
				padding: 6px 7px;
			}
		}
	}
	.listCollaborators {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		li {
			width: 40px;
			height: 40px;
			background: var(--color-primary-0);
			border-radius: 4px;
			color: var(--color-primary-6);
			display: inline-flex;
			align-items: center;
			justify-content: center;
		}
	}
	.buttons {
		display: inline-flex;
		gap: 10px;
		align-items: center;
		padding-top: 4px;
		padding-right: 4px;
		button {
			background: var(--color-primary-7);
			border: none;
			outline: none;
			cursor: pointer;
			font-family: inherit;
			border: 1px solid var(--border-color);
			color: var(--text-color-secondary);
			padding: 6px 12px;
			width: max-content;
			border-radius: 4px;
			font-size: 17px;
			&.active {
				border-color: var(--color-primary-0);
				color: var(--color-primary-0);
			}

			&:hover {
				border-color: var(--color-primary-1);
				color: var(--color-primary-1);
			}
		}
	}
}

.listTickets {
	display: inline-flex;
	gap: 6px;
	width: 100vw;
	overflow-x: scroll;
	height: calc(100vh - 130px);
	background: var(--background);
	padding: 10px;
	&.height {
		height: calc(100vh - 100px);
	}
	&.showGPT {
		filter: blur(4px) grayscale(1);
	}
	/* &::-webkit-scrollbar {
		height: 10px;
	}

	&::-webkit-scrollbar-track {
		background-color: var(--color-primary-7);
	}

	&::-webkit-scrollbar-thumb {
		background-color: var(--color-primary-5);
		border-radius: 5px;
		cursor: e-resize;
	}

	&::-webkit-scrollbar-thumb:hover {
		background-color: var(--color-primary-0);
	} */
	&::-webkit-scrollbar {
		display: none;
	}
	> li {
		padding: 20px;
		min-width: 230px;
		width: 250px;
		background: var(--background-secondary);
		max-height: 100%;
		overflow-y: scroll;
		padding: 4px;
		display: inline-flex;
		flex-direction: column;
		gap: 5px;
		overflow-x: hidden;
		&::-webkit-scrollbar {
			width: 0px;
		}
		&:hover {
			&::-webkit-scrollbar {
				width: 6px;
			}
		}
		/* &::-webkit-scrollbar-track {
			background: var(--color-primary-6);
		}
		&::-webkit-scrollbar-thumb {
			background: var(--color-primary-5);
			border-radius: 5px;
		}
		&::-webkit-scrollbar-thumb:hover {
			background: var(--color-primary-4);
		} */
		&::-webkit-scrollbar {
			display: none;
		}
		.ticket {
			border-radius: 4px;
			display: inline-flex;
			align-items: center;
			justify-content: space-evenly;
			border: 1px solid var(--color-primary-7);
			background: var(--color-primary-7);
			box-shadow: 0px 0px 2px -1px #898383;
			gap: 6px;
			cursor: pointer;
			&:hover {
				border: 1px solid var(--border-color);
				background-color: var(--background-secondary);
			}
			.color {
				min-width: 4px;
				margin-left: -15px;
				height: 100%;
				background: var(--color-primary-6);
				.modalColor {
					> li {
					}
				}
			}
			.content {
				width: 100%;
				display: inline-flex;
				flex-direction: column;
				gap: 5px;
				.topHover {
					padding: 4px 4px 0px;
					display: inline-flex;
					align-items: center;
					justify-content: flex-end;
					gap: 4px;
					display: none;
					button {
						font-size: 11px;
						background: var(--color-primary-6);
						color: var(--color-primary-0);
						font-weight: 600;
						padding: 2px 10px;
						border-radius: 10px;
						border: none;
						font-family: inherit;
						cursor: pointer;
						&:hover {
							background: var(--color-primary-5);
						}
						&.delete {
							background: red;
							color: var(--background);
							&:hover {
								background: red;
							}
						}
					}
				}

				&:hover {
					.topHover {
						display: inline-flex;
					}
				}
				.top {
					padding: 4px 4px 0px;
					display: inline-flex;
					align-items: center;
					justify-content: space-between;
					gap: 4px;
					.title {
						white-space: nowrap;
						overflow: hidden;
						text-overflow: ellipsis;
						font-size: 12px;
					}
					.time {
						display: inline-flex;
						align-items: center;
						justify-content: flex-end;
						gap: 4px;
						> div {
							white-space: nowrap;
							overflow: hidden;
							text-overflow: ellipsis;
							text-align: center;
							font-size: 8px;
							font-weight: 600;
							background: var(--color-primary-6);
							color: var(--color-primary-0);
							padding: 4px 10px;
							border-radius: 10px;
							max-width: 80px;
						}
					}
				}
				&:hover {
					.top {
						display: none;
					}
				}
				.info {
					display: inline-flex;
					flex-direction: column;
					gap: 6px;
				}
				.description {
					padding: 0px 2px;
					border-radius: 5px;
					textarea {
						width: 100%;
						background: var(--background);
						resize: none;
						outline: none;
						padding: 4px;
						color: var(--text-color);
						border: none;
						font-family: inherit;
						&::-webkit-scrollbar {
							display: none;
						}
					}
				}
				.progress {
					padding: 0px 2px 0px 5px;
					display: inline-flex;
					align-items: center;
					gap: 4px;
					width: 100%;
					.status {
					}
					.priority {
					}
					.select {
						width: 100%;
						.boxSearch {
							position: relative;
							display: inline-flex;
							align-items: center;
							gap: 4px;
							border: 1px solid var(--border-color);
							background: var(--background-secondary);
							border-radius: 5px;
							padding: 2px 4px;
							cursor: pointer;
							.dot {
								min-width: 10px;
								width: 10px;
								height: 10px;
								border-radius: 3px;
								background: var(--border-color);
								&._100 {
									background: var(--color-primary-0);
								}
								&._101 {
									background: var(--color-primary-1);
								}
								&._102 {
									background: var(--color-primary-2);
								}
								&._103 {
									background: var(--color-primary-3);
								}
								&._200 {
									background: #dadada;
								}
								&._201 {
									background: #ffa914;
								}
								&._202 {
									background: #f7ff14;
								}
								&._203 {
									background: rgb(255, 30, 30);
								}
								&._204 {
									background: rgb(17, 209, 113);
								}
							}
							input {
								width: 100%;
								background: transparent;
								outline: none;
								padding: 0px;
								font-size: 14px;
								cursor: pointer;
								color: var(--text-color-secondary);
								border: none;
								font-family: inherit;
							}
							&:hover {
								background: var(--background);
							}
							ul {
								position: absolute;
								top: 30px;
								left: 0px;
								width: 100%;
								display: inline-flex;
								flex-direction: column;
								gap: 4px;
								background: var(--background);
								border: 1px solid var(--border-color);
								border-radius: 5px;
								padding: 3px;
								li {
									width: 100%;
									border-radius: 5px;
									background: var(--background-secondary);
									color: var(--text-color-secondary);
									padding: 4px;
									font-size: 12px;
									cursor: pointer;
									display: inline-flex;
									align-items: center;
									gap: 5px;
									&:hover {
										background: var(--background);
									}
								}
							}
						}
						.notFound {
							display: inline-flex;
							align-items: center;
							gap: 6px;
							svg {
								width: 14px;
								height: 14px;
							}
							p {
								font-size: 14px;
							}
						}
					}
				}
				.bottom {
					display: inline-flex;
					justify-content: space-between;
					border-top: 1px solid var(--border-color);
					align-items: flex-end;
					padding: 2px 3px 3px;
					.taskDo {
						> div {
							border-radius: 5px;
							background: var(--color-primary-6);
							color: var(--color-primary-0);
							min-width: 22px;
							height: 22px;
							display: inline-flex;
							align-items: center;
							justify-content: center;
							gap: 4px;
							font-size: 12px;
							font-weight: 500;
							padding: 2px 4px;
							svg {
								height: 14px;
								width: 14px;
							}
						}
					}
					.timeAgo {
						span {
							background-color: var(--color-primary-0);
							color: var(--color-primary-6);
							padding: 3px 6px;
							border-radius: 5px;
							font-size: 12px;
							font-weight: 500;
							cursor: pointer;
						}
					}

					.by {
						display: none;
					}
					.collaborator {
						display: inline-flex;
						align-items: center;
						gap: 6px;
						justify-content: flex-end;
						> div {
							width: 28px;
							height: 28px;
							background: var(--color-primary-6);
							color: var(--color-primary-0);
							border-radius: 5px;
							display: inline-flex;
							align-items: center;
							justify-content: center;
							font-size: 14px;
							font-weight: 600;
							line-height: 15px;
						}
					}
				}
			}
		}
		.headerTicket {
			input {
				line-height: 20px;
				width: 100%;
				font-size: 26px;
				outline: none;
				background: transparent;
				color: var(--color-primary-0);
				border: none;
				font-family: inherit;
			}
		}
		.buttonTicket {
			display: inline-flex;
			align-items: center;
			padding: 0px;
			gap: 5px;

			button {
				width: 100%;
				background: var(--background);
				color: var(--color-primary-0);
				font-size: 15px;
				font-weight: 600;
				line-height: 25px;
				padding: 4px;
				border-radius: 5px;
				border: none;
				font-family: inherit;
				cursor: pointer;
				&:hover {
					background: var(--color-primary-6);
				}
			}
		}
		.buttonAddTask {
			background: var(--color-primary-6);
			color: var(--color-primary-0);
			font-size: 15px;
			font-weight: 600;
			padding: 7px 13px;
			border-radius: 5px;
			margin: 1px;
			cursor: pointer;
			min-height: unset;
			border: none;
			font-family: inherit;
			&:hover {
				background: var(--color-primary-5);
			}
		}
		.liContainer {
			&::-webkit-scrollbar {
				display: none;
			}
		}
		.buttonAddTicket {
			width: 100%;
			background: var(--color-primary-6);
			padding: 14px;
			margin: 12px;
			cursor: pointer;
			z-index: 10000;
			text-align: center;
			box-shadow: 0 9px 46px 35px var(--color-primary-6);

			span {
				color: var(--color-primary-0);
			}
			> div {
				p {
					font-size: 12px;
					color: var(--color-primary-3);
					margin-bottom: 20px;
				}
				> div {
					display: inline-flex;
					align-items: center;
					gap: 12px;
					font-size: 12px;
					font-weight: 600;
					color: var(--color-primary-0);
				}
				button {
					padding: 4px 10px;
					font-size: 12px;
					line-height: 13px;
					font-weight: 500;
					border: none;
					border-radius: 6px;
					background-color: var(--color-primary-5);
					color: var(--color-primary-0);
					font-family: inherit;
					cursor: pointer;
					transition: background-color 0.3s ease;
				}
				button:hover {
					background-color: var(--color-primary-4);
				}
			}
		}
	}
}

.containerKanban {
	display: flex;
	flex-direction: column;
	width: 100%;
}
@media only screen and (max-width: 1200px) {
}

@keyframes leftRight {
	0% {
		width: 20%;
		left: 0px;
	}
	100% {
		width: 40%;
		left: 100%;
	}
}
