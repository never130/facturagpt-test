const getAttachmentFromEmail = async (emailId, attachmentId, accessToken) => {
  try {
    const response = await fetch(
      `https://graph.microsoft.com/v1.0/me/messages/${emailId}/attachments/${attachmentId}`,
      {
        headers: {
          Authorization: `Bearer ${accessToken}`,
          Accept: "application/json",
        },
      }
    );

    if (!response.ok) {
      throw new Error(`Error en la petición: ${response.statusText}`);
    }

    const attachment = await response.json();

    if (!attachment.contentBytes) {
      throw new Error("El adjunto no tiene contenido válido.");
    }

    const buffer = Buffer.from(attachment.contentBytes, "base64");
    const originalName = attachment.name || "archivo_desconocido";
    const mimeType = attachment.contentType || "application/octet-stream";

    return { buffer, originalName, mimeType };
  } catch (error) {
    console.error("Error al obtener el adjunto:", error.message);
    return null;
  }
};


const getOneDriveFileData = async (fileId, accessToken) => {
  try {
    const metadataResponse = await fetch(
      `https://graph.microsoft.com/v1.0/me/drive/items/${fileId}`,
      {
        headers: {
          Authorization: `Bearer ${accessToken}`,
          Accept: "application/json",
        },
      }
    );

    if (!metadataResponse.ok) {
      throw new Error(
        `Error al obtener metadata: ${metadataResponse.statusText}`
      );
    }

    const metadata = await metadataResponse.json();
    const originalName = metadata.name || "archivo_desconocido";
    const mimeType = metadata.file?.mimeType || "application/octet-stream";


    const contentResponse = await fetch(
      `https://graph.microsoft.com/v1.0/me/drive/items/${fileId}/content`,
      {
        headers: {
          Authorization: `Bearer ${accessToken}`,
        },
      }
    );

    if (!contentResponse.ok) {
      throw new Error(
        `Error al obtener contenido: ${contentResponse.statusText}`
      );
    }

    const buffer = await contentResponse.arrayBuffer();

    return { buffer: Buffer.from(buffer), originalName, mimeType };
  } catch (error) {
    console.error("Error al obtener archivo de OneDrive:", error.message);
    return null;
  }
};

module.exports = { getAttachmentFromEmail, getOneDriveFileData };
