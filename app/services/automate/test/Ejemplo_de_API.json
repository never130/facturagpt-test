{
  "name": "Ejemplo de API",
  "baseUrl": "https://api.ejemplo.com",
  "version": "v1",
  "description": "Esta API permite realizar operaciones sobre recursos de ejemplo. Tiene límites de uso de 1000 solicitudes por hora.",
  "endpoints": [
    {
      "name": "Obtener recurso",
      "method": "GET",
      "path": "/recurso/{id}",
      "description": "Este endpoint obtiene un recurso específico por su ID.",
      "authentication": "Bearer token",
      "parameters": {
        "path": [
          {
            "name": "id",
            "type": "number",
            "required": true,
            "description": "ID del recurso a obtener",
            "example": "123"
          }
        ],
        "query": [],
        "body": null
      },
      "responses": {
        "200": {
          "description": "Respuesta exitosa",
          "schema": {
            "type": "object",
            "properties": {
              "nombre": {
                "type": "string",
                "description": "Nombre del recurso"
              },
              "descripcion": {
                "type": "string",
                "description": "Descripción del recurso"
              }
            }
          },
          "example": {
            "nombre": "Recurso 1",
            "descripcion": "Descripción del recurso 1"
          }
        },
        "400": {
          "description": "Error de validación",
          "schema": {
            "type": "object",
            "properties": {
              "error": {
                "type": "string",
                "description": "Mensaje de error"
              }
            }
          }
        },
        "404": {
          "description": "Recurso no encontrado",
          "schema": {
            "type": "object",
            "properties": {
              "error": {
                "type": "string",
                "description": "Mensaje de error"
              }
            }
          }
        }
      },
      "examples": [
        {
          "name": "Ejemplo de uso",
          "request": {
            "method": "GET",
            "url": "https://api.ejemplo.com/recurso/123",
            "headers": {
              "Authorization": "Bearer token"
            },
            "body": null
          },
          "response": {
            "status": 200,
            "body": {
              "nombre": "Recurso 1",
              "descripcion": "Descripción del recurso 1"
            }
          }
        }
      ]
    },
    {
      "name": "Crear recurso",
      "method": "POST",
      "path": "/recurso",
      "description": "Este endpoint crea un nuevo recurso.",
      "authentication": "Bearer token",
      "parameters": {
        "path": [],
        "query": [],
        "body": {
          "type": "object",
          "schema": {
            "properties": {
              "nombre": {
                "type": "string",
                "required": true,
                "description": "Nombre del nuevo recurso",
                "example": "Nuevo Recurso"
              },
              "descripcion": {
                "type": "string",
                "required": false,
                "description": "Descripción del nuevo recurso",
                "example": "Descripción del nuevo recurso"
              }
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "Recurso creado exitosamente",
          "schema": {
            "type": "object",
            "properties": {
              "id": {
                "type": "number",
                "description": "ID del recurso creado"
              }
            }
          },
          "example": {
            "id": 124
          }
        },
        "400": {
          "description": "Error de validación",
          "schema": {
            "type": "object",
            "properties": {
              "error": {
                "type": "string",
                "description": "Mensaje de error"
              }
            }
          }
        }
      },
      "examples": [
        {
          "name": "Ejemplo de uso",
          "request": {
            "method": "POST",
            "url": "https://api.ejemplo.com/recurso",
            "headers": {
              "Authorization": "Bearer token",
              "Content-Type": "application/json"
            },
            "body": {
              "nombre": "Nuevo Recurso",
              "descripcion": "Descripción del nuevo recurso"
            }
          },
          "response": {
            "status": 200,
            "body": {
              "id": 124
            }
          }
        }
      ]
    }
  ],
  "image": {
    "data": "",
    "mimeType": "image/png"
  }
}