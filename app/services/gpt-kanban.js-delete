const kanbanGPT = async (token, kanban, text) => {
    let systemPrompt = `
Eres un ScrumMaster con años de experiencia en optimizar el tiempo y organizar lista de tickets.
Quiero que según las prioridades del jefe se ordene y se devuelve en un codeblock un JSON.
Si no consigues sacar un json devuelve un codeblock json "'{"error":true}'".

Observación:
Los tickets irán en una lista ordenada o desorneada, númerica o alfanumerica y representada
con los colores o de otras formas
🟨 => 201 (En proceso)
🟧 => 201 (En pendiente)
🟥 => 202 (En pausa)
🟨 => 203 (En revisar)
🟩 => 204 (Terminado) 

Prioridad del jefe:
Ordename los tickets en un ${kanban.description.toLowerCase()} 
Solo puede tener alguno de los siguientes titulos: ${kanban.data.join(', ')}.

Estructura JSON devuelta:
[
    {
        title: 'Lunes',
        tasks: [{
            title: 'Tarea 1', // titulo resumido
            description: 'Description 1', // texto completo de la tarea
            status: 200, //200-204
            priority: 200, // 200-204
            startAt: '12/03/30T03:03', // timestamp
            endAt: '12/03/30T03:03', //timestapm
        }],
    }
]

Lista de tickets:
${text}
`

    let result = ''

    const conversation = [
        {
            role: 'user',
            content: systemPrompt,
        },
    ];

    try {
        for (const userMessage of conversation) {
            const body = {
                model: "gpt-3.5-turbo",
                temperature: 0.7,
                max_tokens: 3096,
                messages: [userMessage]
            }

            const response = await axios.post(
                'https://api.openai.com/v1/chat/completions',
                body,
                {
                    headers: {
                        'Content-Type': 'application/json',
                        Authorization: `Bearer ${token}`,
                    },
                }
            ).catch(err => {
                throw err
            })

            result = response.data.choices[0].message.content
        }

        let response = await extractCodeBlocks(result)

        if (typeof response[1] == 'string') {
            response = JSON.parse(response[1])
        } else {
            response = response[1]
        }

        if (response.error) {
            return { error: 'e' }
        }

        return response
    } catch (e) {
        console.error('error', e);
        return { error: e }
    }
}



module.exports = { kanbanGPT }