      }

      console.log('json_response', json_response)



      if (docId || json_response?.type === 'add-docs') {
        if (true) {
          console.log('add_docs - Generating HTML document')


          console.log('threadIdthreadId', threadId)
          try {
            const dbTemplate = await connectDB(`db_${id}_template`)

            let template = null
            console.log('docId!!!', docId)
            // const template = await dbTemplate.get(isDoc.id)

            if (!docId) {
              console.log('efrtgrfecvt')
              await assistantAgent({
