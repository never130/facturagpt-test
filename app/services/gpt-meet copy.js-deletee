        }


        const result = await db.find({
          selector: {
            _id: isRAG[0].id
          },
          limit: 1
        })


        if (result.docs.length == 0) {
          await sendTextData({
            res,
            text: `No se encontró el ${type} #${isRAG[0].id}`,
            type: 'stream',
            conf: {
