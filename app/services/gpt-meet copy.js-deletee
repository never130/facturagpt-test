            id: "gym",
            icon: "🏋️",
            title: "Gimnasio",
            description: "Gimnasio",
            prompt: "Gimnasio",
            fn: 'gym' 
          }, {
            id: "cancel-gym",
            icon: "❌",
            title: "Cancelar",
            description: "Cancelar el gimnasio",
            prompt: "Cancelar el gimnasio",
