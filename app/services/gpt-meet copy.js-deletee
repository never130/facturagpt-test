                userId: id,
                agentId: agentId,
                chatId: chatId
              }
            })

            resolve({
              success: false,
              text: 'Error al generar el documento'
            })
            return false
          }

        }
      }

      // Manejar salida de automatización
      
      if (json_response?.type === 'gym') {
        console.log('User requested to exit agent')

        await assistantAgent({
