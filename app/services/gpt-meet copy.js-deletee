              agentId: agentId,
              chatId: chatId
            }
          })

          resolve({
            success: true,
            text: 'Mira tu nueva tabla'
          })

          return false
        }

        await db.destroy(result.docs[0]._id, result.docs[0]._rev)

        await sendTextData({
          res,
          text: `Se ha eliminado ${type} #${isRAG[0].id}`,
          type: 'stream',
          conf: {
